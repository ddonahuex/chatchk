# Stage 1: Build the Go binary using minimal Go CG image
FROM cgr.dev/chainguard/go AS builder

WORKDIR /app

# Copy all modules
COPY ./src/chatchk chatchk
COPY ./src/ingest ingest
COPY ./src/knowledge knowledge
COPY ./src/prompts prompts
COPY ./src/admin admin
COPY ./src/open_webui open_webui
COPY ./src/ollama ollama
COPY ./src/utils utils

# Build the binary
RUN cd chatchk && \
    go mod tidy && \
    CGO_ENABLED=0 GOOS=linux go build -o /app/chatchk

# Stage 2: Create minimal runtime image (distroless; no shell)
FROM cgr.dev/chainguard/static

WORKDIR /app

# Copy the binary from the builder stage
COPY --from=builder /app/chatchk .

# Copy knowledge files
COPY ./knowledge_files /app/knowledge_files/

# Expose port
EXPOSE 8080

# Environment variables (IP and API_KEY for demo purpose only)
ENV OLLAMA_KNOWLEDGE_FILE=./knowledge_files/customer_support_log.txt
ENV OLLAMA_IP=10.0.0.0
ENV OLLAMA_PORT=30111
ENV OLLAMA_API_KEY=abcdefghjijklmnopqrstuvwxyz

# Run the binary (ENTRYPOINT = CG best practice for distroless image)
ENTRYPOINT ["./chatchk"]
